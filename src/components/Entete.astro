---
import Liens from './Liens.astro';
import { profil } from '../data/profil';

const { identite, liens } = profil;
---

<header class="entete">
  <div class="entete__identite">
    <h1 class="entete__nom">{identite.prenom} {identite.nom}</h1>
    <p class="entete__titre">{identite.titre}</p>
    <p class="entete__accroche">{identite.accroche}</p>

    <div class="entete__meta">
      <p class="entete__lieu">
        <svg
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        {identite.localisation}
      </p>
      <Liens liens={liens} />
    </div>
  </div>
</header>
